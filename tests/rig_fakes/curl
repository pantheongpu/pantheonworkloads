#!/usr/bin/env python3
"""Fake curl for the Hub: http://fake/<repo>/resolve/<rev>/<path> is $FAKE_HF_ROOT/<repo>/<rev>/<path>.
FAKE_CURL_FAIL=<url substring> fails with HTTP FAKE_CURL_FAIL_STATUS (503); FAKE_CURL_FLAKY_N=<n> fails the first n calls per URL.
FAKE_CURL_HALF=1: a call that starts at offset 0 writes half the file and exits 92. -C - resumes at the size of the existing file.
The log line also records the size of the file it found (have), the nice value and --limit-rate; $FAKE_CURL_SLEEP seconds are slept before the copy."""
import json
import os
import shutil
import sys
import time
import urllib.parse

a = sys.argv[1:]
dest = a[a.index("-o") + 1]
url = a[-1]
with open(os.environ["FAKE_CURL_LOG"], "a") as f:
    f.write(json.dumps({"url": url, "headers": [a[i + 1] for i, x in enumerate(a) if x == "-H"], "nice": os.nice(0), "have": os.path.getsize(dest) if os.path.exists(dest) else 0,
                        "limit_rate": a[a.index("--limit-rate") + 1] if "--limit-rate" in a else None}) + "\n")
m = urllib.parse.urlparse(url)
repo, _, rest = m.path.lstrip("/").partition("/resolve/")
rev, _, path = rest.partition("/")
src = os.path.join(os.environ["FAKE_HF_ROOT"], repo, rev, urllib.parse.unquote(path))
if os.environ.get("FAKE_CURL_FAIL") and os.environ["FAKE_CURL_FAIL"] in url:
    sys.stderr.write("curl: (22) The requested URL returned error: %s\n" % os.environ.get("FAKE_CURL_FAIL_STATUS", "503"))
    sys.exit(22)
if os.environ.get("FAKE_CURL_FLAKY_N"):       # the first N calls for each URL exit with FAKE_CURL_FLAKY_CODE (default 92)
    import hashlib
    cf = os.environ["FAKE_CURL_LOG"] + ".flaky-" + hashlib.sha1(url.encode()).hexdigest()[:10]
    n = int(open(cf).read()) if os.path.exists(cf) else 0
    open(cf, "w").write(str(n + 1))
    if n < int(os.environ["FAKE_CURL_FLAKY_N"]):
        sys.stderr.write("curl: (92) HTTP/2 stream 1 was not closed cleanly: CANCEL (err 8)\n")
        sys.exit(int(os.environ.get("FAKE_CURL_FLAKY_CODE", "92")))
if not os.path.isfile(src):
    sys.stderr.write("curl: (22) The requested URL returned error: 404\n")
    sys.exit(22)
time.sleep(float(os.environ.get("FAKE_CURL_SLEEP", "0")))
have = os.path.getsize(dest) if "-C" in a and os.path.exists(dest) else 0      # -C - resumes at the file's size
data = open(src, "rb").read()
if os.environ.get("FAKE_CURL_HALF") and have == 0:        # the connection drops after half the file
    open(dest, "wb").write(data[:len(data) // 2])
    sys.stderr.write("curl: (92) HTTP/2 stream 1 was not closed cleanly: CANCEL (err 8)\n")
    sys.exit(92)
open(dest, "ab" if have else "wb").write(data[have:])
if os.environ.get("FAKE_CURL_CORRUPT") and os.environ["FAKE_CURL_CORRUPT"] in url:
    data = bytearray(open(dest, "rb").read())
    data[0] ^= 0xFF
    open(dest, "wb").write(bytes(data))

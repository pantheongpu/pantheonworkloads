#!/usr/bin/env python3
"""Fake curl for the Hub: http://fake/<repo>/resolve/<rev>/<path> is $FAKE_HF_ROOT/<repo>/<rev>/<path>.
The log line also records the nice value and --limit-rate; $FAKE_CURL_SLEEP seconds are slept before the copy."""
import json
import os
import shutil
import sys
import time
import urllib.parse

a = sys.argv[1:]
dest = a[a.index("-o") + 1]
url = a[-1]
with open(os.environ["FAKE_CURL_LOG"], "a") as f:
    f.write(json.dumps({"url": url, "headers": [a[i + 1] for i, x in enumerate(a) if x == "-H"], "nice": os.nice(0),
                        "limit_rate": a[a.index("--limit-rate") + 1] if "--limit-rate" in a else None}) + "\n")
m = urllib.parse.urlparse(url)
repo, _, rest = m.path.lstrip("/").partition("/resolve/")
rev, _, path = rest.partition("/")
src = os.path.join(os.environ["FAKE_HF_ROOT"], repo, rev, urllib.parse.unquote(path))
if os.environ.get("FAKE_CURL_FAIL") and os.environ["FAKE_CURL_FAIL"] in url:
    sys.stderr.write("curl: (22) The requested URL returned error: 503\n")
    sys.exit(22)
if not os.path.isfile(src):
    sys.stderr.write("curl: (22) The requested URL returned error: 404\n")
    sys.exit(22)
time.sleep(float(os.environ.get("FAKE_CURL_SLEEP", "0")))
shutil.copyfile(src, dest)
if os.environ.get("FAKE_CURL_CORRUPT") and os.environ["FAKE_CURL_CORRUPT"] in url:
    data = bytearray(open(dest, "rb").read())
    data[0] ^= 0xFF
    open(dest, "wb").write(bytes(data))

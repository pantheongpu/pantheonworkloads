#!/usr/bin/env python3
"""Fake ssh: logs the call, answers the rig timer commands from $FAKE_BOX_DIR, runs anything else locally with bash."""
import json
import os
import pathlib
import re
import subprocess
import sys

args = sys.argv[1:]
i = 0
while i < len(args) and args[i].startswith("-"):
    i += 2 if args[i] in ("-i", "-o", "-p", "-l") else 1
host, cmd = args[i], " ".join(args[i + 1:])
with open(os.environ["FAKE_SSH_LOG"], "a") as f:
    f.write(json.dumps({"host": host, "cmd": cmd}) + "\n")
box = pathlib.Path(os.environ["FAKE_BOX_DIR"])
box.mkdir(parents=True, exist_ok=True)
dl = box / "deadline"
if "FAKE_SSH_DOWN" in os.environ:
    sys.stderr.write("ssh: connect to host: Connection refused\n")
    sys.exit(255)
if cmd.startswith("cat /etc/pw-rig/deadline; systemctl"):
    if not dl.exists():
        st = json.loads(pathlib.Path(os.environ["FAKE_AWS_STATE"]).read_text())
        ud = list(st["instances"].values())[-1]["UserData"]
        dl.write_text(re.search(r"printf '%s\\n' (\d+) > /etc/pw-rig/deadline", ud).group(1) + "\n")
    print(dl.read_text().strip())
    print("active")
    sys.exit(0)
m = re.search(r"echo (\d+) \| sudo tee /etc/pw-rig/deadline", cmd)
if m:
    dl.write_text(m.group(1) + "\n")
    print(m.group(1))
    sys.exit(0)
sys.exit(subprocess.run(["bash", "-c", cmd]).returncode)

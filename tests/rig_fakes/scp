#!/usr/bin/env python3
"""Fake scp -r user@host:remote/. local : a local copy (relative remote paths are under $HOME, as with the real one)."""
import os
import shutil
import sys

args = sys.argv[1:]
paths = []
i = 0
while i < len(args):
    if args[i] in ("-i", "-o"):
        i += 2
    elif args[i].startswith("-"):
        i += 1
    else:
        paths.append(args[i])
        i += 1
src, dst = paths
src = src.split(":", 1)[1]
if src.endswith("/."):
    src = src[:-2]
if not src.startswith("/"):
    src = os.path.join(os.environ["HOME"], src)
if not os.path.isdir(src):
    sys.stderr.write("scp: no such directory\n")
    sys.exit(1)
shutil.copytree(src, dst, dirs_exist_ok=True)

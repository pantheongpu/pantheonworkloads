 #define cudaGetErrorString hipGetErrorString
+#if HIP_VERSION < 60000000
+// ROCm 5.x's rocBLAS looks a kernel up in each of its code objects in turn; a miss is hipErrorNotFound, and
+// ROCm 6 and later (the runtimes this backend is written for) keep that failure until the next
+// hipGetLastError, where ROCm 5's next successful call replaced it. A miss is the library's own probing, not an error.
+static inline hipError_t pw_hipGetLastError() {
+    const hipError_t e = hipGetLastError();
+    return e == hipErrorNotFound ? hipSuccess : e;
+}
+#define cudaGetLastError pw_hipGetLastError
+#else
 #define cudaGetLastError hipGetLastError
+#endif
 #define cudaHostAlloc hipHostMalloc
